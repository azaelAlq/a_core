<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:background="@drawable/gastos_quick_add_bg"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gastos_qa_titulo"
            android:textColor="@color/gastos_texto"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/qa_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/gastos_input_bg"
            android:hint="@string/gastos_qa_nombre_hint"
            android:importantForAutofill="no"
            android:inputType="text|textCapSentences"
            android:padding="12dp"
            android:textColor="@color/gastos_texto"
            android:textColorHint="@color/gastos_texto_hint" />

        <EditText
            android:id="@+id/qa_cantidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/gastos_input_bg"
            android:hint="@string/gastos_qa_cantidad_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="@color/gastos_texto"
            android:textColorHint="@color/gastos_texto_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/qa_gasto"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/gastos_qa_gasto"
                android:textAllCaps="false"
                android:textSize="13sp" />

            <Button
                android:id="@+id/qa_ingreso"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/gastos_qa_ingreso"
                android:textAllCaps="false"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/qa_guardar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/gastos_primary"
            android:text="@string/gastos_qa_guardar"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />
    </LinearLayout>
</ScrollView>
