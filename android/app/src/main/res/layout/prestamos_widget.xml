<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gastos_widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/prestamos_widget_nombre"
            android:textColor="@color/gastos_texto"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pw_activos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 activos"
            android:textColor="@color/gastos_texto_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pw_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prestamos_widget_por_cobrar"
            android:textColor="@color/gastos_texto_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/pw_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textColor="@color/gastos_texto"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/pw_add"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="@string/prestamos_widget_agregar"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:backgroundTint="@color/gastos_primary" />
</LinearLayout>
